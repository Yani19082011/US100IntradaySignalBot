# Копирай СЪЩИТЕ стойности от Desktop/PennyStockScanner/.env (същият
# Alpaca paper акаунт работи и тук):
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_DATA_URL=https://data.alpaca.markets

# Resend (email алърти) - СЪЩИЯТ RESEND_API_KEY като другите ботове:
ALERT_EMAIL_ENABLED=true
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
ALERT_EMAIL_TO=yani.kolev2011@gmail.com

# Капитал / leverage:
TOTAL_CAPITAL_EUR=2500
LEVERAGE=20

# Разход (round-trip %, изважда се от P&L) - ПРЕПОРЪЧВАМЕ да смениш с
# реалния си US100 CFD спред, 0.05 е непроверена оценка:
ROUND_TRIP_COST_PCT=0.05

# Прокси инструмент (следи се за сигнала, сделката се изпълнява ръчно на
# твоя US100/NAS100 CFD):
PROXY_SYMBOL=QQQ

# Колко често да проверява през деня (минути):
CHECK_INTERVAL_MINUTES=2

# Принудително затваряне X минути преди края на сесията (без overnight):
FORCE_CLOSE_MINUTES_BEFORE_END=5
# след тази граница преди края НЕ се отварят нови позиции:
NO_NEW_ENTRIES_AFTER_MINUTES_BEFORE_END=30

PORT=10000
